#!/bin/bash

# ==============================================================================
# USER & HOME DIRECTORY
# ==============================================================================
REAL_USER=${SUDO_USER:-$USER}
USER_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)

# ==============================================================================
# DEPENDENCY CHECK ()DISTRO AGNOSTIC)
# ==============================================================================
ensure_dependencies() {
    # We need curl for the GitHub API and Zenity for GUI dialogues
    DEPS=("zenity" "curl")
    MISSING_DEPS=()

    for dep in "${DEPS[@]}"; do
        if ! command -v "$dep" &> /dev/null; then
            MISSING_DEPS+=("$dep")
        fi
    done

    if [ ${#MISSING_DEPS[@]} -gt 0 ]; then
        echo "Missing tools: ${MISSING_DEPS[*]}. Installing..."
        if command -v dnf &> /dev/null; then
            sudo dnf install "${MISSING_DEPS[@]}" -y
        elif command -v apt-get &> /dev/null; then
            sudo apt-get update && sudo apt-get install "${MISSING_DEPS[@]}" -y
        elif command -v pacman &> /dev/null; then
            sudo pacman -S --noconfirm "${MISSING_DEPS[@]}"
        elif command -v zypper &> /dev/null; then
            sudo zypper install -y "${MISSING_DEPS[@]}"
        else
            echo "CRITICAL: Package manager not recognized. Manually install: ${MISSING_DEPS[*]}" >&2
            exit 1
        fi
    fi
}

# Run dependency check first
ensure_dependencies

# ==============================================================================
# CORE FUNCTIONS
# ==============================================================================

# FUNCTION: Show Usage Help Text
show_help_text() {
    echo "================================================================="
    echo " Space Engineers 2 Linux Suite Multitool "
    echo "================================================================="
    echo "Usage: $0 [OPTION]"
    echo ""
    echo "If run without options, an interactive graphical menu will launch."
    echo ""
    echo "Options:"
    echo "  --fix          Directly apply Space Engineers 2 compatibility fixes."
    echo "                 Resets UI/hardware cache and repairs .NET 9 environment."
    echo "  --eggroll      Directly download and install latest GE-Proton."
    echo "  -h, --help     Display this help documentation."
    echo ""
    echo "Prerequisites:"
    echo "  Ensure Space Engineers 2 is fully installed via Steam before"
    echo "  running the fix command."
    echo "================================================================="
}

# FUNCTION: Fix Space Engineers 2 Environment
fix_space_engineers() {
    STEAM_ROOTS=(
        "$USER_HOME/.local/share/Steam"
        "$USER_HOME/.steam/steam"
        "$USER_HOME/.steam/debian-installation"
        "$USER_HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam"
    )

    # Discover the path to the Library Folders VDF
    VDF_PATH=""
    for root in "${STEAM_ROOTS[@]}"; do
        if [[ -f "$root/steamapps/libraryfolders.vdf" ]]; then
            VDF_PATH="$root/steamapps/libraryfolders.vdf"
            STEAM_ROOT_DIR="$root"
            break
        fi
    done

    if [[ -z "$VDF_PATH" ]]; then
        zenity --error --title="Error" --text="Could not find your base Steam installation directory or libraryfolders.vdf."
        return 1
    fi

    # Target Space Engineers 2 APP_ID
    TARGET_APP_ID="1133870"
    GAME_LIBRARY_PATH=""

    # Parse the VDF for the path
    while IFS= read -r line; do
        line=$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
        if [[ "$line" =~ ^\"path\"[[:space:]]+\"(.*)\" ]]; then
            current_path="${BASH_REMATCH[1]}"
            current_path="${current_path//\\\\//}"
        fi
        # Check the file for the APP_ID to ensure the install location
        if [[ "$line" =~ ^\"$TARGET_APP_ID\"[[:space:]]+ ]]; then
            if [[ -d "$current_path/steamapps" ]]; then
                GAME_LIBRARY_PATH="$current_path"
                break
            fi
        fi
    done < "$VDF_PATH"

    if [[ -z "$GAME_LIBRARY_PATH" && -d "$STEAM_ROOT_DIR/steamapps/common/SpaceEngineers2" ]]; then
        GAME_LIBRARY_PATH="$STEAM_ROOT_DIR"
    fi

    if [[ -z "$GAME_LIBRARY_PATH" ]]; then
        zenity --error --title="Error" --text="Space Engineers 2 (AppID: $TARGET_APP_ID) was not found in any registered Steam Library."
        return 1
    fi
    
    # Set the game and compatdata directories.
    GAME_DIR="$GAME_LIBRARY_PATH/steamapps/common/SpaceEngineers2"
    COMPAT_DATA="$GAME_LIBRARY_PATH/steamapps/compatdata/$TARGET_APP_ID"

    zenity --question --title="SE2 Environment Fixer" --text="Target User: $REAL_USER\nGame Found: $GAME_DIR\nCompat Data: $COMPAT_DATA\n\nThis will reset the hardware cache and repair the .NET 9 environment. Continue?" || return 1

    if [ -d "$COMPAT_DATA" ]; then
        echo "Clearing hardware cache..."
        rm -rf "$COMPAT_DATA/pfx/drive_c/users/steamuser/AppData/Roaming/SpaceEngineers2/Temp"
    fi

    echo "Forcing Windows 10 Registry..."
    protontricks 1133870 win10

    echo "Repairing .NET 9 Desktop Runtime..."
    if [ -f "$GAME_DIR/redist/dotnet-runtime-9.0-latest.exe" ]; then
        if [ -n "$SUDO_USER" ]; then
            sudo -u "$REAL_USER" protontricks -c "wine $GAME_DIR/redist/dotnet-runtime-9.0-latest.exe" 1133870
        else
            protontricks -c "wine $GAME_DIR/redist/dotnet-runtime-9.0-latest.exe" 1133870
        fi
    else
        zenity --error --text="Could not find .NET 9 installer at:\n$GAME_DIR/redist/dotnet-runtime-9.0-latest.exe\n\nPlease verify game files in Steam."
        return 1
    fi

    show_final_instructions
}

# FUNCTION: Download and Install Latest GE Proton Build
install_latest_eggroll() {
    # Resolve the standard native compatibility tools destination path
    COMPAT_DIR="$USER_HOME/.steam/steam/compatibilitytools.d"
    
    echo "Ensuring directory exists: $COMPAT_DIR"
    # Ensure creation runs under the real user's scope if running via sudo
    if [ -n "$SUDO_USER" ]; then
        sudo -u "$REAL_USER" mkdir -p "$COMPAT_DIR"
    else
        mkdir -p "$COMPAT_DIR"
    fi

    echo "Fetching latest GE Proton asset info from GitHub API..."
    API_URL="https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest"
    # Use curl to pluck out the proper full browser download url for the .tar.gz package
    TARBALL_URL=$(curl -s "$API_URL" | grep "browser_download_url" | cut -d '"' -f 4 | grep ".tar.gz" | grep -v "aarch64" | head -n 1)

    if [[ -z "$TARBALL_URL" ]]; then
        zenity --error --title="Error" --text="Failed to fetch the latest download link from GloriousEggroll's repository."
        return 1
    fi

    FILENAME=$(basename "$TARBALL_URL")
    TMP_FILE="/tmp/$FILENAME"

    echo "Downloading $FILENAME to temporary space..."
    if [ -n "$SUDO_USER" ]; then
        sudo -u "$REAL_USER" curl -L "$TARBALL_URL" -o "$TMP_FILE"
    else
        curl -L "$TARBALL_URL" -o "$TMP_FILE"
    fi

    echo "Extracting build into compatibilitytools.d..."
    if [ -n "$SUDO_USER" ]; then
        sudo -u "$REAL_USER" tar -xf "$TMP_FILE" -C "$COMPAT_DIR/"
        rm -f "$TMP_FILE"
    else
        tar -xf "$TMP_FILE" -C "$COMPAT_DIR/"
        rm -f "$TMP_FILE"
    fi

    echo "GE Proton update completed."
    zenity --info --title="Proton-GE Installed" --width=350 --text="Successfully downloaded and installed the latest Glorious Eggroll build!\n\nCRITICAL: Please restart Steam completely for the version selection dropdown to refresh."
}

# FUNCTION: Output instructions text window
show_final_instructions() {
    zenity --info --title="Fix Applied" --width=450 --text="Environment Repaired!\n\nFOLLOW THESE FINAL STEPS:\n1. Open Steam, go to Space Engineers 2 -> Properties -> General.\n2. Disable Steam Overlay.\n3. Paste these exact Launch Options:\n\nDISABLE_PRESSURE_VESSEL=1 PROTON_HIDE_NVIDIA_GPU=1 SDL_VIDEODRIVER=x11 %command% -nosplash -skipintro\n\n4. Go to the Compatibility tab.\n5. Check 'Force the use of a specific Steam Play compatibility tool'.\n6. Select your newly installed GE-Proton build from the dropdown list."
}

# ==============================================================================
# SWITCH MANAGEMENT & GUI ENTRY POINT
# ==============================================================================
show_gui_menu() {
    CHOICE=$(zenity --list --radiolist --title="Engineers Suite Multitool" \
        --column="Select" --column="Action Description" \
        TRUE "Apply Space Engineers 2 Wine & Runtime Fixes" \
        FALSE "Download & Install Latest GE-Proton (Glorious Eggroll)" \
        --width=450 --height=220)

    case "$CHOICE" in
        "Apply Space Engineers 2 Wine & Runtime Fixes")
            fix_space_engineers
            ;;
        "Download & Install Latest GE-Proton (Glorious Eggroll)")
            install_latest_eggroll
            ;;
        *)
            echo "Canceled."
            exit 0
            ;;
    esac
}

# Check command line flags before defaulting to GUI menu
case "$1" in
    --fix)
        fix_space_engineers
        ;;
    --eggroll)
        install_latest_eggroll
        ;;
    -h|--help)
        show_help
        ;;
    "")
        show_gui_menu
        ;;
    *)
        echo "Error: Unknown option '$1'"
        show_help
        exit 1
        ;;
esac
